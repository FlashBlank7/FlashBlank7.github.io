{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "flashblank7-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./build", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "flashblank7-studio", "database_id": "CONFIGURE_BEFORE_DEPLOY", "migrations_dir": "./migrations"}],
  "vars": {
    "APP_ORIGIN": "https://CONFIGURE_BEFORE_DEPLOY.workers.dev",
    "GITHUB_APP_ID": "", "GITHUB_CLIENT_ID": "", "GITHUB_INSTALLATION_ID": ""
  },
  "observability": {"enabled": false}
}
