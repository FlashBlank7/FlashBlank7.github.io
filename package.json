{
  "name": "flashblank7-personal-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "tsx scripts/build-site.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test admin/tests/*.test.ts",
    "dev:admin": "vite --config admin/vite.config.ts --host 127.0.0.1",
    "deploy:admin": "pnpm run build:admin && wrangler deploy --config admin/wrangler.jsonc",
    "check": "pnpm run typecheck && pnpm run build:admin && pnpm run build:site && pnpm test"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "markdown-it": "^14.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cheerio": "^1.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.40.0"
  }
}
